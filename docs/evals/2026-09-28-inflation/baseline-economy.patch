+    def _plan_legacy_consumption_after_income(
+        self, market_prices, category_market_snapshot, good_category_lookup,
+        unemployment_rate, unemployment_benefit,
+    ) -> Dict[int, Dict]:
+        """One shopping decision using received income and credit.
+
+        Performance mode keeps seller choices for five ticks but updates money
+        budgets every tick. Only a previously empty basket needs new choices.
+        """
+        if not self.performance_mode or self.current_tick % 5 == 0:
+            plans = self._batch_plan_consumption(
+                market_prices, category_market_snapshot, good_category_lookup,
+                unemployment_rate, unemployment_benefit, settled_income=True,
+            )
+            if self.performance_mode:
+                self._cached_consumption_plans = plans
+            return plans
+
+        budgets = self._household_consumption_budgets(
+            self.households, unemployment_rate, unemployment_benefit, settled_income=True,
+        )
+        cached = self._cached_consumption_plans
+        food_prices = [opt["price"] for opt in category_market_snapshot.get("food", []) if opt["price"] > 0]
+        food_cap = (CONFIG.households.food_health_high_threshold * sum(food_prices) / len(food_prices)
+                    if food_prices else 0.0)
+        refresh_households, refresh_budgets = [], []
+        for household, budget in zip(self.households, budgets):
+            hid = household.household_id
+            previous = cached.get(hid)
+            if previous is None:
+                refresh_households.append(household)
+                refresh_budgets.append(budget)
+                continue
+            reference_budget = previous.setdefault("_reference_budget", previous["budget"])
+            if budget > 0 and (reference_budget <= 0 or not previous["planned_purchases"]):
+                refresh_households.append(household)
+                refresh_budgets.append(budget)
+                continue
+            # Apply the ratio inside the existing market pass, avoiding an
+            # extra pass and a new dictionary for every household's sellers.
+            previous["budget"] = float(budget)
+            previous["_purchase_scale"] = float(budget) / reference_budget if reference_budget > 0 else 0.0
+            previous["_food_budget_cap"] = food_cap
+        if refresh_households:
+            cached.update(self._batch_plan_consumption(
+                market_prices, category_market_snapshot, good_category_lookup,
+                unemployment_rate, unemployment_benefit, settled_income=True,
+                households=refresh_households, budgets=np.asarray(refresh_budgets, dtype=np.float64),
+            ))
+        return cached
+
